# Required — powers wallet lookups (balance + full transfer history),
# the holder count, and the top-holders leaderboard.
# Free tier: helius.dev (1M credits/mo, no card).
HELIUS_API_KEY=

# Shared secret for the /api/discord-stats endpoint. The Raiku Discord bot
# includes this as "Authorization: Bearer <token>" when pushing community
# stats. Generate any long random string; the endpoint stays disabled
# (rejects everything) until this is set.
DISCORD_STATS_TOKEN=
